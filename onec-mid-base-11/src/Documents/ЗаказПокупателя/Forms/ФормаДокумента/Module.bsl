
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	 
	
	ЭлементСтраницы = Элементы.Найти("Страницы");	
	ЭлементСкидка = Элементы.Вставить("ГруппаСкидкаПересчет", Тип("ПолеФормы"),,ЭлементСтраницы);
		
	ГруппаСкидкаПересчет = Элементы.Добавить("ГруппаОбычная", Тип("ГруппаФормы"), ЭтаФорма);
	ГруппаСкидкаПересчет.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСкидкаПересчет.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;  
	
	Элементы.Переместить(ГруппаСкидкаПересчет, ЭтаФорма, ЭлементСтраницы); 
	
	ЭлементСогасованнаяСкидка = Элементы.Добавить("СогласованнаяСкидка", Тип("ПолеФормы"), ГруппаСкидкаПересчет);
	ЭлементСогасованнаяСкидка.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементСогасованнаяСкидка.ПутьКДанным = "Объект.СогласованнаяСкидка";
	ЭлементСогасованнаяСкидка.УстановитьДействие("ПриИзменении", "ПриИзмененииСкидки");
	
	Команда = Команды.Добавить("ПоказатьПредупреждение");
	Команда.Заголовок = "Пересчитать с учетом скидки";
	Команда.Действие = "ПересчитатьСУчетомСкидки";
		
	КнопкаФормы = Элементы.Добавить("КнопкаПоказатьПредупреждение", Тип("КнопкаФормы"), ГруппаСкидкаПересчет);
	КнопкаФормы.ИмяКоманды = "ПоказатьПредупреждение";
	КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;  	
	
КонецПроцедуры

// ++ Иванов Е.А. 20.07.2026  

&НаКлиенте
Процедура ПриИзмененииСкидки(Элемент)
	

	ТекущиеДанныеТаблицыТовары = Элементы.Товары.ТекущиеДанные;
		
	ТекущиеДанныеТаблицыУслуги = Элементы.Услуги.ТекущиеДанные;
	Если ТекущиеДанныеТаблицыТовары = Неопределено И ТекущиеДанныеТаблицыУслуги = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет; 
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаНаКлиенте", ЭтотОбъект, Параметры);  
	
	ПоказатьВопрос(Оповещение, "Изменен процент скидки. Выполнить пересчет товаров и услуг?", Режим); 
    
	
		
КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗакрытияВопросаНаКлиенте(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		
		ПересчитатьСУчетомСкидки();
		
			
	КонецЕсли; 
	
		
КонецПроцедуры

