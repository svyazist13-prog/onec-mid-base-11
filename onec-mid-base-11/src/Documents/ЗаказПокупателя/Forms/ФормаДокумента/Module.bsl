#Область СлужебныеПроцедурыИФункции

// ++ Иванов Е.А. 20.07.2026

&НаКлиенте
Процедура ПересчитатьСУчетомСкидки()
	
	Для Каждого Строка Из Объект.Товары Цикл 
		
		РассчитатьСуммуСтроки(Строка);
      		
	КонецЦикла;
	
	Для Каждого Строка Из Объект.Услуги Цикл 
		
		РассчитатьСуммуСтроки(Строка);
      		
	КонецЦикла; 
	
	РассчитатьСуммуДокумента();
 	
КонецПроцедуры      

// --

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	// ++ Иванов Е.А. 24.07.2026
	// Было:
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	// Стало: 
	
	ОбщаяСкидка = Объект.СогласованнаяСкидка + ТекущиеДанные.Скидка; 
	
	Если ОбщаяСкидка < 100 Тогда
		КоэффициентСкидки = 1 - ОбщаяСкидка / 100; 
		ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки; 
	Иначе
		Сообщить(СтрШаблон("Общая скидка позиции %2 больше 100 процентов и составляет %1, что недопустимо!!!", ОбщаяСкидка, ТекущиеДанные.Номенклатура)); 
		ТекущиеДанные.Сумма = 0;
	КонецЕсли;

    // --    

	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

